# Copy this file to .env and fill in the keys you need.
# .env is local and ignored by Git; this file holds no secrets and is committed.
#
# No key is needed for tests, the Hospital 1 audit and evaluation, the
# Hospital 2, 3, 4 and 5 audits, `semantic h2 status`, `semantic h3 status`,
# `semantic h5 status`, or the Jev Playground export/import.  Variables already set in the OS environment take precedence.
# An empty value means "use the default".

# Required only for Hospital 2 semantic classification:
#   python -m src.main semantic h2 classify
OPENROUTER_API_KEY=

# Required only for direct Jev calls (TypeSafe SystemOne):
#   python -m src.main semantic h2 jev
#   python -m src.main semantic h3 missing-word-run
#   python -m src.main semantic h5 normalize-run | missing-word-run | probe
# The Hospital 3 and 5 audits never need it: they read the committed reviews.
TYPESAFE_API_KEY=

# Optional fallback/overrides
# Fallback Jev key, used only when TYPESAFE_API_KEY is empty.
JEV_API_KEY=
# Jev endpoint; empty means https://api.typesafe.ai/v1/systemone.
JEV_API_URL=
JEV_MODEL=jev-1.13.0
# Hospital 2 Jev acceptance gate: P(ACCEPT) or P(REJECT) must reach this to decide.
JEV_THRESHOLD=0.90
H2_CLASSIFIER_MODEL=z-ai/glm-5.3-flash
# Empty means https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=
# Bounded retries on invalid classifier output; empty means 3.
H2_CLASSIFIER_MAX_ATTEMPTS=
# Upper bound on classifier output tokens; empty means 4096.
H2_CLASSIFIER_MAX_TOKENS=

# Hospital 5 Jev gates (src/hospital_5/semantic.py::GateConfig).  Empty means
# the default shown.  Changing a gate changes which stored reviews are
# accepted; changing JEV_MODEL or a prompt template makes every review stale.
# Global normalisation: choice safe, P(safe) and confidence at least:
H5_JEV_GLOBAL_MIN_PROBABILITY=
H5_JEV_GLOBAL_MIN_CONFIDENCE=
# Context-only normalisation: P(safe) + P(context) at least (default 0.80).
H5_JEV_CONTEXT_MIN_PROBABILITY=
# Missing word: a chosen service needs P and confidence of at least
# (defaults 0.90 / 0.80); "contracted" closure and "unknown" need 0.90.
H5_JEV_SERVICE_MIN_PROBABILITY=
H5_JEV_SERVICE_MIN_CONFIDENCE=
H5_JEV_CLOSURE_MIN_PROBABILITY=
H5_JEV_UNKNOWN_MIN_PROBABILITY=
# Largest candidate set put to one missing-word question (default 8).
H5_JEV_MAX_CANDIDATES=
# Direct-run transport: concurrent requests, bounded retries, timeout seconds
# (defaults 4 / 3 / 60).
H5_JEV_WORKERS=
H5_JEV_MAX_ATTEMPTS=
H5_JEV_TIMEOUT=

# Hospital 3 Jev missing-word gates (src/hospital_3/semantic.py::GateConfig).
# Empty means the default shown; the defaults were fixed before any Hospital 3
# review was run.  Changing a gate changes which stored reviews are accepted;
# changing JEV_MODEL or the prompt template makes every review stale.
# A chosen service needs P and confidence of at least (defaults 0.90 / 0.80);
# "contracted" closure (two or more candidates) and "unknown" need 0.90.
H3_JEV_SERVICE_MIN_PROBABILITY=
H3_JEV_SERVICE_MIN_CONFIDENCE=
H3_JEV_CLOSURE_MIN_PROBABILITY=
H3_JEV_UNKNOWN_MIN_PROBABILITY=
# Largest candidate set put to one question (default 8).
H3_JEV_MAX_CANDIDATES=
# Direct-run transport: concurrent requests, bounded retries, timeout seconds
# (defaults 4 / 3 / 60).
H3_JEV_WORKERS=
H3_JEV_MAX_ATTEMPTS=
H3_JEV_TIMEOUT=
