# Copy this file to .env and fill in the keys you need.
# .env is local and ignored by Git; this file holds no secrets and is committed.
#
# No key is needed for tests, the Hospital 1 audit and evaluation, the
# Hospital 2 deterministic audit, `semantic h2 status`, or the Jev Playground
# export/import.  Variables already set in the OS environment take precedence.
# An empty value means "use the default".

# Required only for Hospital 2 semantic classification:
#   python -m src.main semantic h2 classify
OPENROUTER_API_KEY=

# Required only for direct Jev verification (TypeSafe SystemOne):
#   python -m src.main semantic h2 jev
TYPESAFE_API_KEY=

# Optional fallback/overrides
# Fallback Jev key, used only when TYPESAFE_API_KEY is empty.
JEV_API_KEY=
# Jev endpoint; empty means https://api.typesafe.ai/v1/systemone.
JEV_API_URL=
JEV_MODEL=jev-1.13.0
# Jev acceptance gate: P(ACCEPT) or P(REJECT) must reach this to decide.
JEV_THRESHOLD=0.90
H2_CLASSIFIER_MODEL=z-ai/glm-5.3-flash
# Empty means https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=
# Bounded retries on invalid classifier output; empty means 3.
H2_CLASSIFIER_MAX_ATTEMPTS=
